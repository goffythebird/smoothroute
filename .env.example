# SmoothRoute — Environment Configuration Template
# Copy this file to .env and replace placeholder secrets with your own private credentials:
#   cp .env.example .env
#   node -e "const crypto = require('crypto'); console.log('JWT_SECRET=' + crypto.randomBytes(48).toString('hex'));"

PORT=3847
HOST=0.0.0.0
NODE_ENV=development

# Database path (SQLite)
DB_PATH=./data/smoothroute.db

# Private Authentication & Security Credentials (CHANGE THESE IN PRODUCTION)
JWT_SECRET=replace_with_64_byte_random_hex_secret_do_not_commit
COOKIE_SECRET=replace_with_64_byte_random_hex_cookie_secret
TELEMETRY_HMAC_SECRET=replace_with_32_byte_random_hex_telemetry_signing_key
ADMIN_API_KEY=replace_with_private_admin_api_key

# Token expiration
JWT_EXPIRES_IN_HOURS=168

# Default Map Center (San Francisco / Silicon Valley FSD Corridor)
DEFAULT_MAP_LAT=37.4419
DEFAULT_MAP_LNG=-122.1430
DEFAULT_MAP_ZOOM=11
